BAYTNA_ENV=development
BAYTNA_APP_NAME=Baytna API
BAYTNA_API_PREFIX=/api/v1
BAYTNA_CORS_ORIGINS=http://localhost:3000,http://localhost:8081

BAYTNA_DATABASE_URL=postgresql+psycopg://baytna:baytna_dev_password@localhost:5432/baytna

BAYTNA_OTP_TTL_SECONDS=300
BAYTNA_OTP_MAX_ATTEMPTS=5
BAYTNA_DEV_RETURN_OTP=true
BAYTNA_OTP_PEPPER=change-this-development-otp-pepper

BAYTNA_JWT_SECRET=change-this-development-jwt-secret-at-least-32-characters
BAYTNA_JWT_ALGORITHM=HS256
BAYTNA_ACCESS_TOKEN_TTL_MINUTES=15
BAYTNA_REFRESH_TOKEN_TTL_DAYS=30
BAYTNA_REFRESH_TOKEN_PEPPER=change-this-development-refresh-pepper

BAYTNA_SEED_DEMO_DATA=true

POSTGRES_DB=baytna
POSTGRES_USER=baytna
POSTGRES_PASSWORD=baytna_dev_password
POSTGRES_PORT=5432

BAYTNA_INVENTORY_HOLD_TTL_MINUTES=10

BAYTNA_PAYMENT_PROVIDER=mock
BAYTNA_PAYMENT_WEBHOOK_SECRET=change-this-development-payment-webhook-secret
BAYTNA_PAYMENT_INTENT_TTL_MINUTES=15

BAYTNA_CHEF_ACCEPTANCE_SLA_MINUTES=10

BAYTNA_LOYALTY_MINOR_PER_POINT=1000

BAYTNA_LOYALTY_REDEMPTION_MINOR_PER_POINT=100
BAYTNA_MINIMUM_PAYABLE_MINOR=100

BAYTNA_SPECIAL_ORDER_PAYMENT_WINDOW_MINUTES=1440
BAYTNA_SPECIAL_ORDER_MAX_DAYS_AHEAD=60

BAYTNA_WORKER_BATCH_SIZE=25
BAYTNA_WORKER_POLL_SECONDS=5
BAYTNA_WORKER_STALE_SECONDS=120
BAYTNA_BACKGROUND_JOB_MAX_ATTEMPTS=5
BAYTNA_OUTBOX_MAX_ATTEMPTS=8
BAYTNA_RETRY_BASE_SECONDS=5
BAYTNA_OUTBOX_PUBLISHER=logging


# Sprint 28 — Security / Observability
BAYTNA_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
BAYTNA_TRUST_PROXY_HEADERS=false
BAYTNA_MAX_REQUEST_BODY_BYTES=1048576
BAYTNA_SECURITY_HSTS_ENABLED=false
BAYTNA_SECURITY_HSTS_MAX_AGE_SECONDS=31536000

BAYTNA_RATE_LIMIT_OTP_SEND_IP=60
BAYTNA_RATE_LIMIT_OTP_SEND_PHONE=30
BAYTNA_RATE_LIMIT_OTP_VERIFY_IP=120
BAYTNA_RATE_LIMIT_OTP_VERIFY_PHONE=60
BAYTNA_RATE_LIMIT_REFRESH_IP=120
BAYTNA_RATE_LIMIT_PAYMENT_WEBHOOK_IP=300
BAYTNA_RATE_LIMIT_WINDOW_SECONDS=60

BAYTNA_SECURITY_EVENT_RETENTION_DAYS=30
BAYTNA_RATE_LIMIT_RETENTION_MINUTES=120
BAYTNA_METRICS_ENABLED=true
BAYTNA_METRICS_PATH=/metrics


# Sprint 29 — Media / External Notification Providers
BAYTNA_STORAGE_PROVIDER=local
BAYTNA_STORAGE_LOCAL_ROOT=/tmp/baytna-media
BAYTNA_STORAGE_BUCKET=
BAYTNA_STORAGE_REGION=eu-central-1
BAYTNA_STORAGE_ENDPOINT_URL=
BAYTNA_STORAGE_ACCESS_KEY_ID=
BAYTNA_STORAGE_SECRET_ACCESS_KEY=
BAYTNA_MEDIA_SIGNING_SECRET=change-this-development-media-signing-secret
BAYTNA_MEDIA_UPLOAD_TTL_SECONDS=900
BAYTNA_MEDIA_DOWNLOAD_TTL_SECONDS=300
BAYTNA_MEDIA_MAX_UPLOAD_BYTES=10485760

BAYTNA_INTEGRATION_ENCRYPTION_SECRET=change-this-development-integration-encryption-secret
BAYTNA_NOTIFICATION_PUSH_PROVIDER=logging
BAYTNA_NOTIFICATION_PUSH_ENDPOINT=
BAYTNA_NOTIFICATION_PUSH_BEARER_TOKEN=
BAYTNA_NOTIFICATION_SMS_PROVIDER=logging
BAYTNA_NOTIFICATION_SMS_ENDPOINT=
BAYTNA_NOTIFICATION_SMS_BEARER_TOKEN=
BAYTNA_NOTIFICATION_DELIVERY_MAX_ATTEMPTS=5
BAYTNA_NOTIFICATION_DISPATCH_BATCH_SIZE=50

# Sprint 30 — Provider receipts/reconciliation
BAYTNA_NOTIFICATION_PROVIDER_WEBHOOK_SECRET=change-this-notification-provider-webhook-secret
BAYTNA_NOTIFICATION_RECONCILIATION_BATCH_SIZE=100


# Sprint 31 — Real provider adapters
BAYTNA_FCM_PROJECT_ID=
BAYTNA_FCM_CREDENTIALS_FILE=
BAYTNA_FCM_VALIDATE_ONLY=false

BAYTNA_TWILIO_ACCOUNT_SID=
BAYTNA_TWILIO_AUTH_TOKEN=
BAYTNA_TWILIO_FROM_NUMBER=
BAYTNA_TWILIO_MESSAGING_SERVICE_SID=
BAYTNA_TWILIO_STATUS_CALLBACK_URL=
BAYTNA_TWILIO_API_BASE_URL=https://api.twilio.com/2010-04-01

BAYTNA_PILOT_PUBLIC_BASE_URL=
BAYTNA_PILOT_REQUIRE_REAL_NOTIFICATIONS=false

# Sprint 50 — SLO automation / post-launch stabilization
BAYTNA_SLO_AUTO_PAUSE_DEFAULT_ENABLED=false
BAYTNA_SLO_CONSECUTIVE_RED_SNAPSHOTS=2
BAYTNA_SLO_CAPACITY_FORECAST_LOOKBACK_SNAPSHOTS=6
BAYTNA_LAUNCH_DAILY_CLOSE_CADENCE_ENABLED=false
BAYTNA_LAUNCH_POST_LAUNCH_STABILIZATION_DAYS=7
BAYTNA_LAUNCH_INCOMPLETE_EVIDENCE_RETENTION_DAYS=30
BAYTNA_LAUNCH_EXPANSION_REVIEW_WINDOW_DAYS=7
