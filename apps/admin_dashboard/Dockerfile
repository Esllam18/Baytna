FROM node:22-alpine AS build
WORKDIR /app

ARG VITE_BAYTNA_ENV=staging
ARG VITE_BAYTNA_API_BASE_URL
ARG VITE_BAYTNA_RELEASE=0.49.0
ARG VITE_SENTRY_DSN=
ARG VITE_BAYTNA_ENABLE_DIAGNOSTICS=false

ENV VITE_BAYTNA_ENV=${VITE_BAYTNA_ENV}
ENV VITE_BAYTNA_API_BASE_URL=${VITE_BAYTNA_API_BASE_URL}
ENV VITE_BAYTNA_RELEASE=${VITE_BAYTNA_RELEASE}
ENV VITE_SENTRY_DSN=${VITE_SENTRY_DSN}
ENV VITE_BAYTNA_ENABLE_DIAGNOSTICS=${VITE_BAYTNA_ENABLE_DIAGNOSTICS}

COPY package.json ./
RUN npm install --no-audit --no-fund

COPY tsconfig.json vite.config.ts index.html ./
COPY src ./src

RUN test -n "$VITE_BAYTNA_API_BASE_URL"
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
