EXPO_PUBLIC_BAYTNA_ENV=development
EXPO_PUBLIC_BAYTNA_API_BASE_URL=http://127.0.0.1:8000

EXPO_PUBLIC_BAYTNA_ENABLE_NATIVE_PUSH=false
EXPO_PUBLIC_BAYTNA_RELEASE=0.50.0
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
EXPO_PUBLIC_BAYTNA_ENABLE_DIAGNOSTICS=false

# Keep false for Expo Go/local development. Enable only in a configured Sentry build pipeline.
BAYTNA_ENABLE_SENTRY_METRO=false
