BAYTNA_ENV=production
BAYTNA_APP_NAME=Baytna API
BAYTNA_API_PREFIX=/api/v1

BAYTNA_DATABASE_URL=postgresql+psycopg://baytna:REPLACE_ME@postgres:5432/baytna
POSTGRES_DB=baytna
POSTGRES_USER=baytna
POSTGRES_PASSWORD=REPLACE_ME

BAYTNA_CORS_ORIGINS=https://app.example.com,https://admin.example.com
BAYTNA_ALLOWED_HOSTS=api.example.com
BAYTNA_TRUST_PROXY_HEADERS=true
BAYTNA_SECURITY_HSTS_ENABLED=true

BAYTNA_DEV_RETURN_OTP=false
BAYTNA_SEED_DEMO_DATA=false

BAYTNA_OTP_PEPPER=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
BAYTNA_JWT_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
BAYTNA_REFRESH_TOKEN_PEPPER=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
BAYTNA_PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
BAYTNA_PAYMENT_PROVIDER=paymob

BAYTNA_OUTBOX_PUBLISHER=logging
BAYTNA_METRICS_ENABLED=true

# Tune after load testing.
BAYTNA_RATE_LIMIT_OTP_SEND_IP=20
BAYTNA_RATE_LIMIT_OTP_SEND_PHONE=5
BAYTNA_RATE_LIMIT_OTP_VERIFY_IP=40
BAYTNA_RATE_LIMIT_OTP_VERIFY_PHONE=10
BAYTNA_RATE_LIMIT_REFRESH_IP=120
BAYTNA_RATE_LIMIT_PAYMENT_WEBHOOK_IP=300
BAYTNA_RATE_LIMIT_WINDOW_SECONDS=60


# Sprint 29 — Production integrations
BAYTNA_STORAGE_PROVIDER=s3
BAYTNA_STORAGE_BUCKET=baytna-production
BAYTNA_STORAGE_REGION=eu-central-1
BAYTNA_STORAGE_ENDPOINT_URL=
# Prefer workload/IAM identity; set static keys only when required by provider.
BAYTNA_STORAGE_ACCESS_KEY_ID=
BAYTNA_STORAGE_SECRET_ACCESS_KEY=
BAYTNA_MEDIA_SIGNING_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS

BAYTNA_INTEGRATION_ENCRYPTION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
BAYTNA_NOTIFICATION_PUSH_PROVIDER=fcm
BAYTNA_FCM_PROJECT_ID=REPLACE_FIREBASE_PROJECT_ID
BAYTNA_FCM_CREDENTIALS_FILE=

BAYTNA_NOTIFICATION_SMS_PROVIDER=twilio
BAYTNA_TWILIO_ACCOUNT_SID=AC_REPLACE_ME
BAYTNA_TWILIO_AUTH_TOKEN=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
BAYTNA_TWILIO_FROM_NUMBER=+1REPLACE_ME
BAYTNA_TWILIO_MESSAGING_SERVICE_SID=
BAYTNA_TWILIO_STATUS_CALLBACK_URL=https://api.example.com/api/v1/notifications/vendor-webhooks/twilio/status

# Sprint 30 — Provider receipts/reconciliation
BAYTNA_NOTIFICATION_PROVIDER_WEBHOOK_SECRET=change-this-notification-provider-webhook-secret
BAYTNA_NOTIFICATION_RECONCILIATION_BATCH_SIZE=100


# Sprint 32 — Paymob
BAYTNA_PAYMOB_BASE_URL=https://accept.paymob.com
BAYTNA_PAYMOB_SECRET_KEY=REPLACE_PAYMOB_SECRET_KEY
BAYTNA_PAYMOB_PUBLIC_KEY=REPLACE_PAYMOB_PUBLIC_KEY
BAYTNA_PAYMOB_HMAC_SECRET=REPLACE_PAYMOB_HMAC_SECRET
BAYTNA_PAYMOB_PAYMENT_METHODS=REPLACE_INTEGRATION_ID
BAYTNA_PAYMOB_NOTIFICATION_URL=https://api.example.com/api/v1/payments/webhooks/paymob/transaction
BAYTNA_PAYMOB_REDIRECTION_URL=https://app.example.com/payment/result
BAYTNA_PAYMOB_REFUND_ENABLED=false
BAYTNA_PAYMOB_API_KEY=

BAYTNA_PROVIDER_IMPORT_MAX_LINES=2000
BAYTNA_PROVIDER_IMPORT_REQUEST_TIMEOUT_SECONDS=20
BAYTNA_EXPANSION_ROLLOUT_REQUIRED=true
BAYTNA_EXPANSION_REQUIRED_BUDGET_CATEGORIES=operations,chef_onboarding,delivery_supply,contingency
BAYTNA_EXPANSION_CANARY_PERCENT=10
BAYTNA_EXPANSION_LIMITED_PERCENT=50
BAYTNA_EXPANSION_DEFAULT_DAILY_ORDER_CAP=25

BAYTNA_TRAFFIC_REQUIRE_DELIVERY_ADDRESS_FOR_CHECKOUT=true
BAYTNA_TRAFFIC_DEFAULT_HOURLY_ORDER_CAP=8
BAYTNA_TRAFFIC_DEFAULT_CHEF_DAILY_ORDER_CAP=12
BAYTNA_TRAFFIC_WARNING_UTILIZATION_PCT=80
BAYTNA_TRAFFIC_CRITICAL_UTILIZATION_PCT=95
BAYTNA_TRAFFIC_REJECTION_SPIKE_PCT=30
BAYTNA_TRAFFIC_REJECTION_SPIKE_MIN_ATTEMPTS=5
BAYTNA_VENDOR_ACCOUNTING_REQUIRE_DUAL_CONTROL=true
BAYTNA_VENDOR_ACCOUNTING_REQUIRE_CLOSED_SETTLEMENTS_FOR_ROLLOUT=true
BAYTNA_VENDOR_ACCOUNTING_HIGH_VALUE_IMPORT_MINOR=1000000
BAYTNA_LAUNCH_COMMAND_REQUIRED=true
BAYTNA_LAUNCH_COMMAND_REQUIRE_DUAL_CONTROL=true
BAYTNA_LAUNCH_OVERRIDE_MAX_MINUTES=120
BAYTNA_LAUNCH_FINANCIAL_CLOSE_GRACE_HOURS=8
BAYTNA_LAUNCH_ROLLBACK_TARGET_SECONDS=300
BAYTNA_LAUNCH_EVIDENCE_REQUIRE_NO_ACTIVE_OVERRIDES=true
BAYTNA_SLO_AUTO_PAUSE_DEFAULT_ENABLED=true
BAYTNA_SLO_CONSECUTIVE_RED_SNAPSHOTS=2
BAYTNA_SLO_CAPACITY_FORECAST_LOOKBACK_SNAPSHOTS=6
BAYTNA_LAUNCH_DAILY_CLOSE_CADENCE_ENABLED=true
BAYTNA_LAUNCH_POST_LAUNCH_STABILIZATION_DAYS=7
BAYTNA_LAUNCH_INCOMPLETE_EVIDENCE_RETENTION_DAYS=30
BAYTNA_LAUNCH_EXPANSION_REVIEW_WINDOW_DAYS=7
